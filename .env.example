# public-api-demo settings.
# This file holds a real agency secret when filled in: keep the real .env out of git,
# tickets and chats.
#
# Get your agency API key at https://www.tangoagent.io/agency-key
# (register an agency at https://business.tango.me/developers -> create an API key ->
# add creator accounts).
#
# Precedence for every value below: CLI flag > process environment variable > this file > default.
#
# Fastest way to fill this in: run `python3 python/demo.py init` (or `./bash/demo.sh init`) - it
# writes this file for you, interactively or from flags, and never overwrites a key you don't ask
# it to change.

# --- Agency credentials (HTTP Basic). Required for `creators` and `stream`.
TANGO_CLIENT_ID=
TANGO_CLIENT_SECRET=

# --- Creator to act on. Set it once and drop --creator-id from every `stream` call.
# Find it with: python3 python/demo.py creators
TANGO_CREATOR_ID=
